# Calendar GraphQL read load
ERP_GRAPHQL_URL=https://your-erp-host/api/graphql
ERP_AUTH_TOKEN=your-frappe-token

# Calendar read settings
TEST_YEAR=2026
EVENT_PAGE_SIZE=500
EMPLOYEE_PAGE_SIZE=1000
ROLE_PAGE_SIZE=1000
CUSTOMER_PAGE_SIZE=500

# Load profile: use either RATE+DURATION or STAGES
RATE=25
DURATION=2m
# STAGES=10:1m,25:2m,50:3m,100:5m
# START_RATE=1
PRE_ALLOCATED_VUS=40
MAX_VUS=250
SLEEP_SECONDS=0.2

# Optional k6 outputs
# K6_SUMMARY_EXPORT=load-tests/k6/results/calendar-read-summary.json
